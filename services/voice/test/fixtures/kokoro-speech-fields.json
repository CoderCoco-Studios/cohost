  "source": "https://github.com/remsky/Kokoro-FastAPI/blob/v0.10.0/api/src/structures/schemas.py",
  "tag": "v0.10.0",
  "note": "Fields of OpenAISpeechRequest (with its SpeechOptions base) and NormalizationOptions at the Kokoro-FastAPI tag docker-compose.yml pins. The voice synthesizer may send only these.",
  "request": [
    "model", "input", "voice", "response_format", "download_format", "speed", "stream",
