# Copy to .env (install.sh does this). Secrets and per-machine settings live here;
# everything behavioural lives in config/config.yaml.

# --- compose ---------------------------------------------------------------
# install.sh sets this to include the GPU overlay when an NVIDIA GPU is present.
COMPOSE_FILE=docker-compose.yml
# Optional services to start with the stack: `eyes` (vision), `ears` (listens), `mouth` (speaks) and `discord` (the Discord
# connector that carries the voice channel to and from them). Listing them here keeps them on across restarts and Launch.
# The Discord ones need the bot token and ids below.
# COMPOSE_PROFILES=discord,ears,mouth
# GPU: COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml. A Windows docker.exe (COHOST_DOCKER_BIN below) splits
# that list on `;`, so also set COMPOSE_PATH_SEPARATOR=: in that case.
# Override the TTS / STT images (the GPU overlay switches them to the CUDA builds by default).
# KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:v0.10.0
# SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:0.8.3-cpu

# --- Host-run dashboard (`pnpm dashboard`) -------------------------------------
# The dashboard runs on the host, not in Compose; its Launch button starts the stack.
# Full surface (page, controls, Launch/Stop): http://localhost:DASHBOARD_PORT.
DASHBOARD_PORT=3000
# LAN listener (sink page and audio only): the second-PC OBS Browser Source.
DASHBOARD_LAN_PORT=3001
# Where the full surface listens. 127.0.0.1 = this machine only. 0.0.0.0 opens the full dashboard to
# other machines and then requires CONTROL_ENABLED=1 and CONTROL_TOKEN (the dashboard refuses to start otherwise).
DASHBOARD_HOST=127.0.0.1
# Stack controls (Launch / Stop / restart). install.sh fills CONTROL_TOKEN on first run; to make one by hand:
#   openssl rand -hex 24
# The page asks for it once per browser tab. It is sent as a bearer token over plain HTTP.
CONTROL_ENABLED=1
CONTROL_TOKEN=
# Address the dashboard's control surface binds to when CONTROL_ENABLED=1. Unset = loopback only.
# CONTROL_BIND=127.0.0.1
# 1 lets the controls also stop and restart redis and postgres (read-only by default).
# CONTROL_ADVANCED=0
# The docker executable the dashboard and cohostctl run. WSL2 without Docker Desktop's WSL integration
# has no `docker` on its PATH: set this to docker.exe.
# COHOST_DOCKER_BIN=docker.exe

# --- Test uploads (dashboard "inject" panel) -----------------------------------
# Limits for the images and audio you inject for testing. Unset = the defaults shown.
# INJECT_MAX_IMAGE_BYTES=8388608
# INJECT_MAX_AUDIO_BYTES=26214400
# INJECT_TTL_MS=600000

# --- Isolation presets ---------------------------------------------------------
# Each flips one backend without editing config/config.yaml (config.example.yaml reads them as ${VAR:-default}).
# The mock/off values need no account, model server or Discord: use them to run one service in isolation.
# The dashboard's "isolated" start sets the right ones for a single service. Unset = the live default shown first.
# LLM_PROVIDER=ollama            # ollama | openai | anthropic | bedrock | mock
# MEMORY_STORE=postgres          # postgres | memory (in-process, lost on exit)
# MEMORY_EMBEDDER=ollama         # ollama | hash (offline)
# VOICE_ENGINE=kokoro            # kokoro | stub (silence)
# CHAT_SOURCE=twitch             # twitch | fake (scripted messages)
# VISION_ENABLED=false           # true starts the describer; needs VISION_MODEL
# EARS_SOURCE=discord            # legacy single source: discord | http | dir | off; config.yaml ears.sources (a list) wins when set
# CONNECTIONS_DISCORD_ENABLED=true  # false = the Discord connector idles and holds no connection
# MOUTH_DISCORD_ENABLED=true     # false = mouth idles and plays nothing
# VISION_ENGINE=ollama           # ollama | stub (fixed description, no model call)
# EARS_HTTP_TOKEN=               # bearer token for ears' POST /audio (empty = none)
# EARS_STT_ENGINE=speaches       # speaches | stub (fixed transcript, no STT server)
# MOUTH_DRYRUN_ENABLED=false     # true = the dry-run output accepts lines and plays nothing
# MOUTH_FILE_ENABLED=false       # true = the file output appends each line's WAV under the data directory
# MOUTH_HTTP_ENABLED=false       # true = the http output POSTs each line's WAV to MOUTH_HTTP_URL
# MOUTH_HTTP_URL=                # an http(s) URL for the http output; empty = the output is down

# --- Ollama models (pulled by the `models` service) ---------------------------
# Size these to your GPU. Which provider answers (ollama / openai / anthropic / bedrock)
# and every brain hook are chosen in config/config.yaml; this file only holds secrets.
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
VISION_MODEL=qwen2.5vl:3b
# Small model that classifies each chat line into viewer notes (brain.memory.notes.capture). Runs on local Ollama,
# separate from LLM_MODEL. A failed pull is only a warning (capture then writes no notes).
NOTES_MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text

# --- Speech-to-text model (not pulled by the `models` service) ---------------
# ears sends this model name to the `stt` service with each transcription request.
STT_MODEL=Systran/faster-whisper-small

# --- model API keys (only for the provider you picked in config.yaml) --------
LLM_API_KEY=                 # llm.provider: openai  (vLLM box, OpenRouter, Groq ...)
ANTHROPIC_API_KEY=           # llm.provider: anthropic
AWS_ACCESS_KEY_ID=           # llm.provider: bedrock (keys go here; Compose mounts no ~/.aws)
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- Twitch (https://dev.twitch.tv/console, scopes: chat:read chat:edit) ----
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=        # required whenever TWITCH_ACCESS_TOKEN is set

# --- Discord (https://discord.com/developers) -------------------------------
# DISCORD_TOKEN is the co-host's one Discord bot, used by the Discord connector (profile `discord`) only: it logs in,
# holds the one voice connection and serves both ears (hearing) and mouth (speaking), which hold no Discord client.
# Invite it with Connect and Speak, and enable the Server Members intent.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# --- OBS on the gaming PC (Tools > WebSocket Server Settings) --------------
# From WSL/Docker on the same machine use host.docker.internal; on a 2nd PC use its LAN IP.
OBS_HOST=host.docker.internal
OBS_PORT=4455
OBS_PASSWORD=
OBS_SOURCE="Game Capture"

# --- Avatar app --------------------------------------------------------------
# AVATAR_DRIVER: vtube-studio | vmc | null   (null = no avatar app, dashboard only)
AVATAR_DRIVER=null
VTS_HOST=host.docker.internal
VTS_PORT=8001
VMC_HOST=host.docker.internal
VMC_PORT=39539

# --- Service health ----------------------------------------------------------
# How often each service publishes its heartbeat (ms). Dashboard "services" tab
# and the compose healthchecks derive staleness from this.
# HEARTBEAT_INTERVAL_MS=5000

# --- Files ---------------------------------------------------------------------
# Where services keep files they must remember across restarts (refreshed Twitch tokens, the fallback clip cache).
# Unset = `data/` under the repository root.
# COHOST_DATA_DIR=

# --- Dashboard Viewers page --------------------------------------------------
# What the co-host remembers about each viewer (notes, including health and family
# notes) is shown only on the dashboard Viewers tab, behind this secret. Leave it
# empty and the tab stays locked (every /viewers route answers 403). Generate one
# with: openssl rand -hex 24   The page asks for it once per browser tab.
# It is sent as a bearer token over plain HTTP: keep the dashboard on a trusted LAN.
VIEWERS_TOKEN=
