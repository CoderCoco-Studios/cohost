{
  "name": "cohost",
  "private": true,
  "version": "0.1.0",
  "description": "Locally hosted AI VTuber co-host \u2014 modular services on a Redis bus",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "dev": "pnpm -r --parallel --filter './services/*' dev",
    "lint": "tsc -b --noEmit",
    "reflect": "pnpm --filter @cohost/brain reflect",
    "clean": "rm -rf packages/*/dist services/*/dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@snazzah/davey",
      "libsodium-wrappers",
      "opusscript"
    ]
  }
}
