# Copy to .env (install.sh does this). Secrets and per-machine settings live here;
# everything behavioural lives in config/config.yaml.

# --- compose ---------------------------------------------------------------
# install.sh sets this to include the GPU overlay when an NVIDIA GPU is present.
COMPOSE_FILE=docker-compose.yml

# --- Host-run dashboard (`pnpm dashboard`) -------------------------------------
# The dashboard runs on the host, not in Compose; its Launch button starts the stack.
# Full surface (page, controls, Launch/Stop): http://localhost:DASHBOARD_PORT.
DASHBOARD_PORT=3000
# LAN listener (sink page, audio, test uploads only): second-PC OBS Browser Source and the containers
# (eyes/ears reach it at host.docker.internal:DASHBOARD_LAN_PORT).
DASHBOARD_LAN_PORT=3001
# Where the full surface listens. 127.0.0.1 = this machine only. 0.0.0.0 opens the full dashboard to
# other machines and then requires CONTROL_ENABLED=1 and CONTROL_TOKEN (the dashboard refuses to start otherwise).
DASHBOARD_HOST=127.0.0.1
# Stack controls (Launch / Stop / restart). install.sh fills CONTROL_TOKEN on first run; to make one by hand:
#   openssl rand -hex 24
# The page asks for it once per browser tab. It is sent as a bearer token over plain HTTP.
CONTROL_ENABLED=1
CONTROL_TOKEN=
# The docker executable the dashboard and cohostctl run. WSL2 without Docker Desktop's WSL integration
# has no `docker` on its PATH: set this to docker.exe.
# COHOST_DOCKER_BIN=docker.exe
# Where eyes/ears fetch injected test uploads. Unset = http://host.docker.internal:DASHBOARD_LAN_PORT (on Linux
# Compose maps that name to the host gateway). Set it to the host's address if the containers cannot reach that name.
# DASHBOARD_URL=

# --- Ollama models (pulled by the `models` service) ---------------------------
# Size these to your GPU. Which provider answers (ollama / openai / anthropic / bedrock)
# and every brain hook are chosen in config/config.yaml; this file only holds secrets.
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
VISION_MODEL=qwen2.5vl:3b
# Small model that classifies each chat line into viewer notes (brain.memory.notes.capture). Runs on local Ollama,
# separate from LLM_MODEL. A failed pull is only a warning (capture then writes no notes).
NOTES_MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text

# --- Speech-to-text model (not pulled by the `models` service) ---------------
# ears sends this model name to the `stt` service with each transcription request.
STT_MODEL=Systran/faster-whisper-small

# --- model API keys (only for the provider you picked in config.yaml) --------
LLM_API_KEY=                 # llm.provider: openai  (vLLM box, OpenRouter, Groq ...)
ANTHROPIC_API_KEY=           # llm.provider: anthropic
AWS_ACCESS_KEY_ID=           # llm.provider: bedrock (keys go here; Compose mounts no ~/.aws)
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- Twitch (https://dev.twitch.tv/console, scopes: chat:read chat:edit) ----
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=        # required whenever TWITCH_ACCESS_TOKEN is set

# --- Discord bot (https://discord.com/developers, enable Message Content + voice)
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# --- OBS on the gaming PC (Tools > WebSocket Server Settings) --------------
# From WSL/Docker on the same machine use host.docker.internal; on a 2nd PC use its LAN IP.
OBS_HOST=host.docker.internal
OBS_PORT=4455
OBS_PASSWORD=
OBS_SOURCE="Game Capture"

# --- Avatar app --------------------------------------------------------------
# AVATAR_DRIVER: vtube-studio | vmc | null   (null = no avatar app, dashboard only)
AVATAR_DRIVER=null
VTS_HOST=host.docker.internal
VTS_PORT=8001
VMC_HOST=host.docker.internal
VMC_PORT=39539

# --- Service health ----------------------------------------------------------
# How often each service publishes its heartbeat (ms). Dashboard "services" tab
# and the compose healthchecks derive staleness from this.
# HEARTBEAT_INTERVAL_MS=5000

# --- Dashboard Viewers page --------------------------------------------------
# What the co-host remembers about each viewer (notes, including health and family
# notes) is shown only on the dashboard Viewers tab, behind this secret. Leave it
# empty and the tab stays locked (every /viewers route answers 403). Generate one
# with: openssl rand -hex 24   The page asks for it once per browser tab.
# It is sent as a bearer token over plain HTTP: keep the dashboard on a trusted LAN.
VIEWERS_TOKEN=
