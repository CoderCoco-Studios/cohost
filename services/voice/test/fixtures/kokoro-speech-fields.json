    "voice_aliases", "lang_code", "volume_multiplier", "normalization_options"
  ],
  "normalization_options": [
    "normalize", "unit_normalization", "url_normalization", "email_normalization",
    "optional_pluralization_normalization", "phone_normalization", "caps_normalization",
    "replace_remaining_symbols", "remove_emoji"
  ],
  "bounds": { "speed": [0.25, 4], "volume_multiplier": [0, 10] },
  "lang_codes": ["a", "b", "e", "f", "h", "i", "j", "p", "z"]
}
