{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "affect hook reply",
  "description": "How one line moves the mood. Deltas outside -0.5..0.5 are clamped.",
  "type": "object",
  "required": [
    "valence_delta",
    "arousal_delta"
  ],
  "properties": {
    "valence_delta": {
      "type": "number",
      "minimum": -0.5,
      "maximum": 0.5
    },
    "arousal_delta": {
      "type": "number",
      "minimum": -0.5,
      "maximum": 0.5
    }
  }
}
