# Copy to .env (install.sh does this). Secrets and per-machine settings live here;
# everything behavioural lives in config/config.yaml.

# --- compose ---------------------------------------------------------------
# install.sh sets this to include the GPU overlay when an NVIDIA GPU is present.
COMPOSE_FILE=docker-compose.yml
DASHBOARD_PORT=3000

# --- models (pulled by the `models` service) --------------------------------
# LLM_PROVIDER: ollama (default, local) | openai | anthropic | bedrock. See README "Stronger model".
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# openai-compatible endpoint (provider=openai): e.g. a rented vLLM box or OpenRouter
LLM_BASE_URL=
LLM_API_KEY=
# Claude (provider=anthropic). For provider=bedrock set AWS_REGION + the usual AWS_* credentials instead.
ANTHROPIC_API_KEY=
AWS_REGION=

# --- brain hooks (see examples/modules/) ------------------------------------
# Each is rules (default, built in) | llm (ask a model) | http (POST to your own model).
SALIENCE_MODULE=
SALIENCE_MODULE_URL=
AFFECT_MODULE=
AFFECT_MODULE_URL=
CORTEX_CRITIC=
CORTEX_CRITIC_URL=
# For kind=llm hooks: a different (smaller/cheaper) model than the cortex uses. Empty = same as LLM_*.
MODULE_LLM_PROVIDER=
MODULE_LLM_MODEL=
VISION_MODEL=qwen2.5vl:3b
EMBED_MODEL=nomic-embed-text
STT_MODEL=Systran/faster-whisper-small

# --- Twitch (https://dev.twitch.tv/console, scopes: chat:read chat:edit) ----
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# --- Discord bot (https://discord.com/developers, enable Message Content + voice)
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# --- OBS on the gaming PC (Tools > WebSocket Server Settings) --------------
# From WSL/Docker on the same machine use host.docker.internal; on a 2nd PC use its LAN IP.
OBS_HOST=host.docker.internal
OBS_PORT=4455
OBS_PASSWORD=
OBS_SOURCE="Game Capture"

# --- Avatar app --------------------------------------------------------------
# AVATAR_DRIVER: vtube-studio | vmc | null   (null = no avatar app, dashboard only)
AVATAR_DRIVER=null
VTS_HOST=host.docker.internal
VTS_PORT=8001
VMC_HOST=host.docker.internal
VMC_PORT=39539
