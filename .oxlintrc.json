// The TypeScript lint's rule set (deployment design, "Linting"). `mise run lint:ts` runs `oxlint --type-aware
// --deny-warnings`, so every finding fails the lint. Each rule turned off below says why.
// @spec DEPLOY-LINT-001, DEPLOY-LINT-002, DEPLOY-LINT-003
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // A disable comment that suppresses nothing is itself an error.
  "options": { "reportUnusedDisableDirectives": "error" },
  "plugins": ["eslint", "typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "rules": {
    // node:test's test(), describe() and hooks return promises the runner itself awaits.
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "package": "node:test", "name": ["test", "describe", "it", "suite", "before", "after", "beforeEach", "afterEach"] }
        ]
      }
    ],
    // A leading underscore marks a binding unused on purpose (a drained `for await (const _ of req)`, an interface parameter
    // a no-op ignores); destructuring a key out to drop it from the rest (`const { createDriver, ...boot } = env`) narrows an object.
    "eslint/no-unused-vars": [
      "error",
      { "ignoreRestSiblings": true, "varsIgnorePattern": "^_", "argsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_" }
    ],
    // Promise-handling rules outside the two categories.
    "typescript/no-misused-promises": "error",
    // Rethrowing or rejecting with a caught error or an abort reason (`unknown`) keeps what was thrown; a literal non-Error
    // is reported.
    "typescript/only-throw-error": ["error", { "allowThrowingUnknown": true, "allowThrowingAny": true }],
    "typescript/prefer-promise-reject-errors": ["error", { "allowThrowingUnknown": true, "allowThrowingAny": true }],
    // `String(value)` of an `unknown` (parsed JSON, a YAML scalar) is how such a value becomes text; typescript-eslint's
    // default leaves `unknown` unchecked too. `ArrayBuffer` is ignored because it reaches the rule only through ws's
    // `RawData` (`Buffer | ArrayBuffer | Buffer[]`), and ws delivers a `Buffer` under the default `binaryType` every socket uses.
    "typescript/no-base-to-string": ["error", { "checkUnknown": false, "ignoredTypeNames": ["Error", "RegExp", "URL", "URLSearchParams", "ArrayBuffer"] }],
    // A string array sorts correctly without a comparator; typescript-eslint's default ignores string arrays too.
    "typescript/require-array-sort-compare": ["error", { "ignoreStringArrays": true }],
    // Spreading a string is how the project counts code points, its unit for viewer-text bounds (`[...text].length`).
    "typescript/no-misused-spread": ["error", { "allow": [{ "from": "lib", "name": "string" }] }],

    // Off: asserting a parsed or boundary value to its known shape (JSON, fakes cast `as never` in tests) is the project's
    // pattern; the rule reports every such assertion.
    "typescript/no-unsafe-type-assertion": "off",
    // Off: about 690 hits under the project's own compiler options, many of them assertions tsc needs (`x as never` passed to
    // a typed parameter, `object as T`); its autofix removes those and breaks the build.
    "typescript/no-unnecessary-type-assertion": "off",
    // Off: the fix is `toSorted()`/`toReversed()`, ES2023 methods outside the workspace's `lib` (ES2022); sorting a fresh
    // or owned array in place is intended.
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    // Off: reports deliberate copies: iterating a snapshot of a set its loop body changes (`for (const l of [...listeners])`)
    // and counting code points (`[...text].length`); its fix changes behaviour.
    "unicorn/no-useless-spread": "off",
    // Off: `new Array(n).fill(x)` is unambiguous; TypeScript already types the single-length-argument form.
    "unicorn/no-new-array": "off",
    // Off: a style rule (helpers declared inside the function that uses them).
    "unicorn/consistent-function-scoping": "off",
    // Off: a naming-style rule.
    "eslint/no-underscore-dangle": "off",
    // Off: block scoping and strict mode make a shadowed name a local choice; no-unused-vars catches the shadowed
    // binding that is never read.
    "eslint/no-shadow": "off",
    // Off: `noImplicitReturns` (tsconfig.base.json) is the check, and tsc sees exhaustiveness and calls that never return.
    // What this rule reports beyond it is correct code: a `switch` over a union that returns in every case, a helper ending
    // in `assert.fail`, a React effect that returns a cleanup on one path only, a hook that returns nothing to mean "unchanged".
    "typescript/consistent-return": "off",
    // Off: the text sanitizers (viewer text, secrets, tool output) match control characters on purpose.
    "eslint/no-control-regex": "off",
    // Off: each `on*` handler is set once on a socket or audio element the code just created, and the dashboard's test fakes
    // (FakeSocket, FakeAudio) model those handler properties.
    "unicorn/prefer-add-event-listener": "off"
  },
  "overrides": [
    {
      "files": ["**/test/**"],
      "rules": {
        // Test stub servers take async request handlers; a throw there fails the test through the client's request.
        "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "arguments": false } }],
        // Off in tests: a test sorts both sides of a deepEqual into the same deterministic default order.
        "typescript/require-array-sort-compare": "off"
      }
    }
  ]
}
